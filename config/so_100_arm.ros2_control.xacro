<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="so_100_arm_ros2_control" params="name initial_positions_file use_fake_hardware" >
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>
        <xacro:property name="motor_ids" value="${xacro.load_yaml(initial_positions_file)['motor_ids']}"/>
        <xacro:property name="zero_positions" value="${xacro.load_yaml(initial_positions_file)['zero_positions']}"/>
        <xacro:property name="directions" value="${xacro.load_yaml(initial_positions_file)['directions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <xacro:if value="${use_fake_hardware}">
                    <plugin>mock_components/GenericSystem</plugin>
                </xacro:if>
                <xacro:unless value="${use_fake_hardware}">
                    <plugin>so_arm_100_controller/SOARM100Interface</plugin>
                    <param name="use_serial">true</param>
                    <param name="serial_port">/dev/ttyUSB0</param>
                    <param name="serial_baudrate">1000000</param>
                </xacro:unless>
            </hardware>
            <joint name="Shoulder_Rotation">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Shoulder_Rotation']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <param name="motor_id">${motor_ids['Shoulder_Rotation']}</param>
                <param name="zero_position">${zero_positions['Shoulder_Rotation']}</param>
                <param name="direction">${directions['Shoulder_Rotation']}</param>
            </joint>
            <joint name="Shoulder_Pitch">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Shoulder_Pitch']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <param name="motor_id">${motor_ids['Shoulder_Pitch']}</param>
                <param name="zero_position">${zero_positions['Shoulder_Pitch']}</param>
                <param name="direction">${directions['Shoulder_Pitch']}</param>
            </joint>
            <joint name="Elbow">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Elbow']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <param name="motor_id">${motor_ids['Elbow']}</param>
                <param name="zero_position">${zero_positions['Elbow']}</param>
                <param name="direction">${directions['Elbow']}</param>
            </joint>
            <joint name="Wrist_Pitch">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Wrist_Pitch']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <param name="motor_id">${motor_ids['Wrist_Pitch']}</param>
                <param name="zero_position">${zero_positions['Wrist_Pitch']}</param>
                <param name="direction">${directions['Wrist_Pitch']}</param>
            </joint>
            <joint name="Wrist_Roll">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Wrist_Roll']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <param name="motor_id">${motor_ids['Wrist_Roll']}</param>
                <param name="zero_position">${zero_positions['Wrist_Roll']}</param>
                <param name="direction">${directions['Wrist_Roll']}</param>
            </joint>
            <joint name="Gripper">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Gripper']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <param name="motor_id">${motor_ids['Gripper']}</param>
                <param name="zero_position">${zero_positions['Gripper']}</param>
                <param name="direction">${directions['Gripper']}</param>
            </joint>

        </ros2_control>
    </xacro:macro>
</robot>
